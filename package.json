{
  "name": "guos-puzzle-duel-4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @gpd4/client build && pnpm --filter @gpd4/host build",
    "start": "node --disable-warning=ExperimentalWarning apps/host/dist/host.mjs",
    "dev:client": "pnpm --filter @gpd4/client dev",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tools/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:smoke": "vitest run --config tools/vitest.smoke.config.ts",
    "test:e2e": "pnpm --filter @gpd4/client test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
